    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.1",
    "mongodb-memory-server": "^9.2.0",
    "mongoose": "^8.4.0",
